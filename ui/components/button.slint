import { Theme } from "../theme.slint";

// A native-looking button with primary / secondary / danger variants.
export component BaseButton inherits Rectangle {
    in property <string> text;
    in property <color> base-color: Theme.action;
    in property <color> hover-color: Theme.action-hover;
    in property <color> pressed-color: Theme.action-pressed;
    in property <color> text-color: Theme.on-action;
    in property <bool> outlined: false;
    in property <bool> disabled: false;
    // Outline color used when `outlined` is true. Defaults reproduce the
    // Secondary button's border/border-strong hover pair; DangerOutlineButton
    // overrides both to `danger` so it keeps a single outline color across
    // hover states instead of the neutral secondary progression.
    in property <color> outline-color: Theme.border;
    in property <color> outline-color-hover: Theme.border-strong;
    out property <bool> pressed: !root.disabled && touch.pressed;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked;

    accessible-role: button;
    accessible-enabled: !root.disabled;
    accessible-label: root.text;
    accessible-action-default => {
        if (!root.disabled) {
            root.focus();
            root.clicked();
        }
    }

    forward-focus: focus-scope;

    height: Theme.control-height;
    min-width: 72px;
    preferred-width: max(72px, button-label.preferred-width + Theme.space-lg);
    horizontal-stretch: 0;
    border-radius: Theme.radius-md;
    background: root.disabled ? Theme.surface-disabled
             : root.outlined
                ? (touch.pressed ? Theme.surface-pressed
                    : touch.has-hover ? Theme.surface-hover : Theme.surface)
             : touch.pressed ? root.pressed-color
             : touch.has-hover ? root.hover-color
             : root.base-color;
    // Primary and Danger solid buttons have no border in any state,
    // including disabled. Outlined variants (Secondary/DangerOutline) always
    // keep a 1px outline, including when disabled — a disabled Secondary
    // button with no border loses its clickable shape and reads as plain
    // gray text. Default/hover use `outline-color`/`outline-color-hover`;
    // disabled falls back to the neutral `Theme.border` regardless of which
    // outline color the variant configured (danger-red on a disabled button
    // would misleadingly imply the danger action is still available).
    border-color: root.outlined
                    ? (root.disabled ? Theme.border
                        : touch.has-hover ? root.outline-color-hover : root.outline-color)
                 : transparent;
    border-width: root.outlined ? 1px : 0px;

    touch := TouchArea {
        enabled: !root.disabled;
        mouse-cursor: pointer;
        clicked => {
            if (!root.disabled) {
                root.focus();
                root.clicked();
            }
        }
    }

    focus-scope := FocusScope {
        x: 0px;
        width: 0px;
        enabled: !root.disabled;
        key-pressed(event) => {
            if (!root.disabled && (event.text == " " || event.text == "\n" || event.text == Key.Return)) {
                root.focus();
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    if root.has-focus && !root.disabled : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: Theme.radius-md + 2px;
        border-color: Theme.focus-ring;
        border-width: 2px;
        background: transparent;
    }

    button-label := Text {
        text: root.text;
        // Disabled buttons pair `Theme.text-disabled` with
        // `Theme.surface-disabled`, but that combination is only 1.65:1 —
        // effectively unreadable (issue 14 defect 4). `Theme.text-muted`
        // restores 4.22:1: still visibly weaker than enabled text (as a
        // disabled control should read), but legible. Recorded as a
        // deliberate deviation from the design spec, not a token bug.
        color: root.disabled ? Theme.text-muted
             : root.text-color;
        font-size: Theme.font-body;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

export component PrimaryButton inherits BaseButton {
    base-color: Theme.action;
}
export component SecondaryButton inherits BaseButton {
    outlined: true;
    text-color: Theme.text-primary;
}
// Solid red variant. Reserved for future destructive-confirmation prompts;
// "cancel task" uses DangerOutlineButton below to avoid excessive emphasis.
export component DangerButton inherits BaseButton {
    base-color: Theme.danger;
    hover-color: Theme.danger-hover;
    pressed-color: Theme.danger-pressed;
    text-color: Theme.on-accent;
}
// `surface` background + 1px `danger` outline + `danger` text.
// Used for "cancel task" so the destructive action doesn't compete visually
// with the solid-red DangerButton reserved for future confirmation prompts.
export component DangerOutlineButton inherits BaseButton {
    outlined: true;
    text-color: Theme.danger-text;
    outline-color: Theme.danger;
    outline-color-hover: Theme.danger;
}
