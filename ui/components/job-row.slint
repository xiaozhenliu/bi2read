import { Theme } from "../theme.slint";
import { StageStyle } from "../stage-style.slint";
import { ProgressBar } from "progress.slint";

// One row in the task queue list.
//
// The root element is a transparent spacer sized `task-row-height +
// task-row-gap` so the virtualized ListView (which has no `spacing`, see
// The virtualized ListView can still produce card-style gaps: the visible
// `card` rectangle is pinned to the top of root and the row's own bottom
// `task-row-gap` px are left empty below it. Click hotspot, hover, the focus
// ring and the selected indicator all live inside `card`, so none of them
// bleed into that trailing gap.
export component JobRowView inherits Rectangle {
    in property <string> title;
    in property <string> bvid;
    in property <int> page;
    in property <string> stage-name;
    in property <string> stage-label;
    in property <string> status-label;
    in property <string> status-name;
    in property <int> stage-progress;     // 0..100 for current stage
    in property <int> total-progress;    // 0..100 across whole job
    in property <bool> indeterminate;
    in property <bool> selected;
    in property <bool> has-error;
    in property <string> elapsed;        // preformatted "MM:SS"
    property <string> display-elapsed: root.elapsed.is-empty || root.elapsed == "00:00"
        ? "—" : root.elapsed;
    // Single source of truth for stage-semantic colors (dot / bar / meta
    // text). Resolved once so every visual below reads the same kind.
    property <string> kind: StageStyle.kind(root.status-name, root.stage-name, root.has-error, root.total-progress);
    property <bool> progress-indeterminate: root.indeterminate
        && (root.kind == "download" || root.kind == "transcribe" || root.kind == "polish");
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();
    callback navigate(int);

    changed selected => {
        if root.selected {
            root.focus();
        }
    }

    accessible-role: list-item;
    accessible-enabled: true;
    accessible-label: root.title + "，" + root.bvid
        + (root.page > 1 ? " 第" + root.page + "P" : "")
        + "，状态 " + root.status-label + "，阶段 " + root.stage-label + "，"
        + (root.has-error ? "错误"
            : (root.indeterminate
                ? "处理中，总进度未知"
                : "阶段进度 " + root.stage-progress + "%，总进度 " + root.total-progress + "%"));
    accessible-action-default => {
        root.focus();
        root.clicked();
    }
    forward-focus: focus-scope;

    height: Theme.task-row-height + Theme.task-row-gap;
    background: transparent;

    card := Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: Theme.task-row-height;
        border-radius: Theme.radius-md;
        background: root.selected ? Theme.surface-selected
                 : touch.pressed ? Theme.surface-pressed
                 : touch.has-hover ? Theme.surface-hover : Theme.surface;
        // Inactive cards stay quiet, including failures; status icon/text carry
        // the error meaning. Only selection and keyboard focus get a strong edge.
        border-color: root.has-focus ? Theme.focus-ring
                     : root.selected ? Theme.border-strong : Theme.border;
        border-width: root.has-focus ? 2px : 1px;

        if root.selected : Rectangle {
            x: 0px;
            y: Theme.space-sm;
            width: 3px;
            height: parent.height - 2 * Theme.space-sm;
            border-radius: 1.5px;
            background: Theme.selection;
        }

        VerticalLayout {
            padding-left: Theme.space-sm;
            padding-right: Theme.space-sm;
            padding-top: Theme.space-xs;
            padding-bottom: Theme.space-xs;
            spacing: Theme.space-xxs;

            Text {
                text: root.title;
                color: Theme.text-primary;
                font-size: Theme.font-body;
                font-weight: 600;
                height: 20px;
                overflow: elide;
                vertical-alignment: center;
            }
            HorizontalLayout {
                height: 16px;
                spacing: Theme.space-xs;
                Text {
                    text: root.bvid + (root.page > 1 ? "-P" + root.page : "");
                    color: Theme.text-secondary;
                    font-size: Theme.font-caption;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    text: root.display-elapsed;
                    color: Theme.text-muted;
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                height: 16px;
                spacing: Theme.space-xs;
                Rectangle {
                    width: 6px;
                    height: 6px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 3px;
                    background: StageStyle.dot(root.kind);
                }
                Text {
                    text: StageStyle.label(root.status-name, root.stage-name, root.has-error, root.total-progress, root.status-label);
                    color: StageStyle.badge-text-color(root.kind);
                    font-size: Theme.font-caption;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Text {
                    text: root.progress-indeterminate ? "处理中" : root.total-progress + "%";
                    color: StageStyle.bar-text-color(root.kind);
                    font-size: Theme.font-caption;
                    vertical-alignment: center;
                }
            }
            ProgressBar {
                value: root.total-progress;
                indeterminate: root.progress-indeterminate;
                height: 4px;
                label: "任务总进度";
                bar-color: StageStyle.bar(root.kind);
                track-color: root.selected ? Theme.selected-track : Theme.track;
            }
        }

        touch := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.focus();
                root.clicked();
            }
        }
    }

    focus-scope := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.focus();
                root.clicked();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.navigate(-1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.navigate(1);
                return accept;
            }
            return reject;
        }
    }
}
