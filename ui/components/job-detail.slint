import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { StageStyle } from "../stage-style.slint";
import { PrimaryButton, SecondaryButton, DangerOutlineButton } from "button.slint";
import { IconButton } from "icon-button.slint";
import { AppTextField } from "text-field.slint";
import { StatusBadge } from "badge.slint";
import { ProgressBar } from "progress.slint";
import { StageView, SpeakerEntry } from "../types.slint";

// Segmented-control tab: container is `InspectorTab`'s parent
// `segment-track` Rectangle; each tab renders its own selected/unselected
// look and owns tab-list keyboard semantics.
component InspectorTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <int> focus-generation: 0;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked;
    callback navigate(int);

    changed selected => {
        if root.selected {
            root.focus();
        }
    }
    changed focus-generation => {
        if root.selected {
            root.focus();
        }
    }

    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => {
        root.focus();
        root.clicked();
    }
    forward-focus: focus-scope;

    // Cross-axis size (height) comes from the `segment-track` container's
    // HorizontalLayout, which stretches unsized children to its own inner
    // height (track height 32 minus 2px padding on each side = 28).
    min-width: 92px;
    horizontal-stretch: 1;
    border-radius: Theme.radius-sm;
    background: root.selected ? Theme.surface : transparent;
    // The selected segment carries a subtle lift (y1/blur3);
    // unselected stays flat.
    drop-shadow-offset-y: root.selected ? 1px : 0px;
    drop-shadow-blur: root.selected ? 3px : 0px;
    drop-shadow-color: root.selected ? Theme.shadow-segment : transparent;

    Text {
        text: root.text;
        color: root.selected ? Theme.text-primary : Theme.text-secondary;
        font-size: Theme.font-body;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.focus();
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == " " || event.text == Key.Return {
                root.focus();
                root.clicked();
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.navigate(-1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.navigate(1);
                return accept;
            }
            return reject;
        }
    }

    if root.has-focus : Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-radius: Theme.radius-md + 2px;
        border-color: Theme.focus-ring;
        border-width: 2px;
        background: transparent;
    }
}

export component StageRow inherits Rectangle {
    in property <StageView> stage;

    accessible-role: list-item;
    accessible-enabled: true;
    accessible-label: root.stage.label
        + (root.stage.error ? "，错误"
            : root.stage.skipped ? "，已跳过"
            : root.stage.done ? "，已完成"
            : root.stage.active
                ? (root.stage.indeterminate ? "，处理中" : "，进度 " + root.stage.progress + "%")
                : "，等待中");

    height: 34px;

    HorizontalLayout {
        spacing: Theme.space-sm;
        padding-left: Theme.space-xxs;
        padding-right: Theme.space-xxs;

        Image {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            source: root.stage.error ? @image-url("../icons/warning.svg")
                : root.stage.done ? @image-url("../icons/check-circle.svg")
                : root.stage.active ? @image-url("../icons/dot-circle.svg")
                : root.stage.skipped ? @image-url("../icons/minus-circle.svg")
                : @image-url("../icons/circle.svg");
            colorize: root.stage.error ? Theme.danger
                : root.stage.done ? Theme.success
                : root.stage.active ? Theme.accent
                : root.stage.skipped ? Theme.text-disabled : Theme.text-muted;
        }

        Text {
            text: root.stage.label;
            color: root.stage.error ? Theme.danger
                : root.stage.active ? Theme.text-primary
                : root.stage.done ? Theme.text-secondary : Theme.text-muted;
            font-size: Theme.font-body;
            font-weight: root.stage.active || root.stage.error ? 600 : 400;
            width: 126px;
            overflow: elide;
            vertical-alignment: center;
        }

        if root.stage.active : ProgressBar {
            value: root.stage.progress;
            indeterminate: root.stage.indeterminate;
            height: 5px;
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 1;
            label: root.stage.label + "进度";
        }

        if !root.stage.active : Rectangle { horizontal-stretch: 1; }

        Text {
            text: root.stage.error ? "错误"
                : root.stage.skipped ? (root.stage.name == "screenshots" ? "未启用" : "已跳过")
                : root.stage.done ? "已完成"
                : root.stage.active ? (root.stage.indeterminate ? "处理中" : root.stage.progress + "%")
                : "等待";
            color: root.stage.error ? Theme.danger
                : root.stage.active ? Theme.accent-text : Theme.text-muted;
            font-size: Theme.font-caption;
            width: 64px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: parent.width;
        background: Theme.separator;
    }
}

export component SpeakerRow inherits Rectangle {
    in property <SpeakerEntry> entry;
    in property <bool> enabled: true;
    callback name-edited(string);

    accessible-role: list-item;
    accessible-enabled: true;
    accessible-label: root.entry.raw-label
        + (root.entry.name.is-empty ? "，未设置显示名称" : "，显示为 " + root.entry.name);

    // Caption line (12px) + 4px gaps above/between/below + 32px compact
    // input = 60px, on the 4px spacing grid.
    height: 60px;

    // "原始标签 · 出现 N 段" (spec.md 第二节第 12 条); a `segment-count` of 0
    // means the count is unavailable rather than "zero segments", so only
    // the raw label is shown.
    property <string> caption-text: root.entry.segment-count > 0
        ? root.entry.raw-label + " · 出现 " + root.entry.segment-count + " 段"
        : root.entry.raw-label;

    VerticalLayout {
        padding-left: Theme.space-xs;
        padding-right: Theme.space-xs;
        padding-top: Theme.space-xxs;
        padding-bottom: Theme.space-xxs;
        spacing: Theme.space-xxs;

        Text {
            text: root.caption-text;
            color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
            font-size: Theme.font-caption;
            overflow: elide;
        }

        AppTextField {
            accessible-label: root.entry.raw-label + " 的显示名称";
            enabled: root.enabled;
            compact: true;
            text: root.entry.name;
            placeholder-text: "输入显示名称…";
            edited(value) => { root.name-edited(value); }
        }
    }

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: parent.width;
        background: Theme.separator;
    }
}

component OptionRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> muted: false;

    height: 34px;
    accessible-role: text;
    accessible-label: root.label + "，" + root.value;

    HorizontalLayout {
        spacing: Theme.space-xs;
        Text {
            text: root.label;
            color: Theme.text-muted;
            font-size: Theme.font-caption;
            width: 82px;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: root.muted ? Theme.text-disabled : Theme.text-primary;
            font-size: Theme.font-body;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
    }
}

// Confirmed design C: queue (in App), task status overview (center), and a
// dedicated collapsible speaker/task-information inspector (right). Each visible pane
// owns at most one vertical scroller; no same-direction scroller is nested.
export component JobDetail inherits Rectangle {
    in property <bool> has-job;
    in property <string> title;
    in property <string> bvid;
    in property <int> page;
    in property <string> status-label;
    // Machine-readable current stage key (`JobDetailData.stage-name`, sourced
    // from `snap.stage.name()` in src/main.rs). Drives `StageStyle` lookups
    // for the header badge/progress-bar color, symmetric with
    // `JobRow.stage-name`.
    in property <string> stage-name;
    // Machine-readable JobStatus key (`JobDetailData.status-name`, sourced
    // from `snap.status.name()` in src/main.rs). Outranks `stage-name` in
    // `StageStyle` lookups when task-level status is decisive (e.g.
    // `cancelling`).
    in property <string> status-name;
    in property <int> total-progress;
    in property <string> elapsed;
    in property <string> error-text;
    in property <bool> has-error;
    in property <string> warning-text;
    in property <[StageView]> stages;
    in property <[SpeakerEntry]> speakers;
    in property <bool> can-cancel;
    in property <bool> can-retry;
    in property <bool> can-open;
    in property <bool> can-reveal;
    in property <bool> can-delete;
    in property <bool> can-edit-speakers;
    in property <bool> screenshots-enabled;
    in property <string> retention-label;
    in property <string> created-at;
    in property <string> started-at;
    in property <string> finished-at;
    in property <string> video-duration;
    in property <string> media-size;
    in property <string> document-words;
    in property <string> transcription-runtime;
    in property <string> transcription-source;
    in property <string> transcription-backend;
    in property <string> transcription-model;
    in property <string> requested-language;
    in property <string> reported-language;
    in property <string> reported-model;
    in property <string> action-feedback: "";
    in property <bool> action-pending: false;
    in property <bool> action-feedback-error: false;
    in property <string> speaker-feedback: "";
    in property <bool> speaker-feedback-error: false;
    in property <string> verification-fixture: "";
    in property <int> verification-inspector-page: 0;

    property <bool> fixture-enabled: !root.verification-fixture.is-empty;
    property <bool> fixture-running: root.verification-fixture == "running";
    property <bool> fixture-failed: root.verification-fixture == "failed";
    property <bool> fixture-completed: root.verification-fixture == "completed";
    property <bool> display-has-job: root.has-job || root.fixture-enabled;
    property <string> display-title: root.fixture-enabled
        ? "这是一个用于验证详情滚动的超长视频标题：包含多个说话人、错误信息和任务阶段"
        : root.title;
    property <string> display-bvid: root.fixture-enabled ? "BV1UIFIX" : root.bvid;
    property <int> display-page: root.fixture-enabled ? 2 : root.page;
    property <string> display-status: root.fixture-running ? "处理中"
        : root.fixture-failed ? "失败"
        : root.fixture-completed ? "已完成" : root.status-label;
    property <int> display-progress: root.fixture-completed ? 100
        : root.fixture-running ? 48
        : root.fixture-failed ? 64 : root.total-progress;
    // Fixture stand-ins mirror the three fixture states so StageStyle.kind()
    // resolves the same color group the corresponding real stage-name would.
    // Fixture stand-ins mirror the three fixture states so StageStyle.kind()
    // resolves the same color group the corresponding real stage-name would.
    property <string> display-stage-name: root.fixture-running ? "transcribe"
        : root.fixture-failed ? "failed"
        : root.fixture-completed ? "completed" : root.stage-name;
    // Fixture stand-in for status-name, mirroring display-stage-name so
    // StageStyle.kind()/label() resolve the same status-decisive branch the
    // corresponding real status-name would.
    property <string> display-status-name: root.fixture-running ? "running"
        : root.fixture-failed ? "failed"
        : root.fixture-completed ? "completed" : root.status-name;
    property <string> display-elapsed: root.fixture-running ? "09:16"
        : root.fixture-completed ? "24:03"
        : root.fixture-failed ? "18:42"
        : (root.elapsed.is-empty || (root.elapsed == "00:00"
            && root.status-label == "排队中") ? "—" : root.elapsed);
    property <string> display-error: root.fixture-failed
        ? "远端服务返回了较长的错误说明。原始转写已安全保存，可以稍后重试；重试不会重新下载或转写音频。\n技术信息：upstream request timed out after 120 seconds。"
        : root.error-text;
    property <bool> display-error-visible: root.fixture-failed || (!root.fixture-enabled && root.has-error);
    property <string> display-warning: root.fixture-enabled ? "" : root.warning-text;
    property <bool> display-warning-visible: !root.display-warning.is-empty;
    property <bool> display-can-cancel: root.fixture-running || (!root.fixture-enabled && root.can-cancel);
    property <bool> display-can-retry: root.fixture-failed || (!root.fixture-enabled && root.can-retry);
    property <bool> display-can-open: root.fixture-completed || (!root.fixture-enabled && root.can-open);
    property <bool> display-can-reveal: root.fixture-completed || (!root.fixture-enabled && root.can-reveal);
    // Terminal fixtures (completed/failed) expose the delete affordance so
    // screenshots cover it; a running task must go through cancel first.
    property <bool> display-can-delete: (root.fixture-completed || root.fixture-failed)
        || (!root.fixture-enabled && root.can-delete);
    property <bool> display-can-edit-speakers: root.fixture-completed
        || (!root.fixture-enabled && root.can-edit-speakers);
    property <string> display-retention: root.fixture-enabled ? "推荐" : root.retention-label;
    property <string> display-created-at: root.fixture-enabled ? "2026-08-08 10:14:32" : root.created-at;
    property <string> display-started-at: root.fixture-enabled ? "2026-08-08 10:14:36" : root.started-at;
    property <string> display-finished-at: root.fixture-running ? "—"
        : root.fixture-completed ? "2026-08-08 10:38:39"
        : root.fixture-failed ? "2026-08-08 10:33:18" : root.finished-at;
    property <string> display-video-duration: root.fixture-enabled ? "47:13" : root.video-duration;
    property <string> display-media-size: root.fixture-completed
        ? "已按保留策略清理"
        : root.fixture-enabled ? "86.4 MB（音频）" : root.media-size;
    property <string> display-document-words: root.fixture-running
        ? "尚未生成"
        : root.fixture-failed ? "18,640 字（原始稿）"
        : root.fixture-completed ? "15,284 字" : root.document-words;
    property <string> display-transcription-runtime: root.fixture-enabled
        ? "内置 Runtime" : root.transcription-runtime;
    property <string> display-transcription-source: root.fixture-enabled
        ? "bundled" : root.transcription-source;
    property <string> display-transcription-backend: root.fixture-enabled
        ? "native-uv" : root.transcription-backend;
    property <string> display-transcription-model: root.fixture-enabled
        ? "未提供" : root.transcription-model;
    property <string> display-requested-language: root.fixture-enabled
        ? "中文" : root.requested-language;
    property <string> display-reported-language: root.fixture-enabled
        ? (root.fixture-completed ? "未报告" : "未报告") : root.reported-language;
    property <string> display-reported-model: root.fixture-enabled
        ? "未报告" : root.reported-model;
    property <bool> display-has-actions: root.display-can-cancel || root.display-can-retry
        || root.display-can-open || root.display-can-reveal || root.display-can-delete;
    property <bool> display-completed: root.display-status == "已完成";

    changed verification-inspector-page => {
        if root.verification-inspector-page > 0 {
            root.inspector-page = root.verification-inspector-page;
        }
    }

    property <[StageView]> fixture-stages: [
        { name: "metadata", label: "元数据", done: true, active: false, progress: 100, indeterminate: false, error: false, skipped: false },
        { name: "download_audio", label: "下载音频", done: true, active: false, progress: 100, indeterminate: false, error: false, skipped: false },
        { name: "normalize_audio", label: "转换音频", done: true, active: false, progress: 100, indeterminate: false, error: false, skipped: false },
        { name: "transcribe", label: "FunASR 转写", done: !root.fixture-running, active: root.fixture-running, progress: root.fixture-running ? 48 : 100, indeterminate: root.fixture-running, error: false, skipped: false },
        { name: "raw_document", label: "原始文档", done: root.fixture-failed || root.fixture-completed, active: false, progress: 0, indeterminate: false, error: false, skipped: false },
        { name: "readable_document", label: "可读文档", done: root.fixture-completed, active: false, progress: 0, indeterminate: false, error: root.fixture-failed, skipped: false },
        { name: "screenshots", label: "截图", done: false, active: false, progress: 0, indeterminate: false, error: false, skipped: root.fixture-completed },
        { name: "final_document", label: "最终文档", done: root.fixture-completed, active: false, progress: 0, indeterminate: false, error: false, skipped: false },
        { name: "cleanup", label: "清理", done: root.fixture-completed, active: false, progress: 0, indeterminate: false, error: false, skipped: false },
        { name: "completed", label: "完成", done: root.fixture-completed, active: false, progress: 0, indeterminate: false, error: false, skipped: false }
    ];
    // segment-count values are plausible fixture stand-ins (descending, one
    // speaker at 0 to exercise the "count unavailable" caption branch), not
    // real transcript data.
    property <[SpeakerEntry]> fixture-speakers: [
        { speaker-id: 0, raw-label: "Speaker 0", name: "主持人", segment-count: 142 },
        { speaker-id: 1, raw-label: "Speaker 1", name: "嘉宾一号", segment-count: 87 },
        { speaker-id: 2, raw-label: "Speaker 2", name: "嘉宾二号", segment-count: 56 },
        { speaker-id: 3, raw-label: "Speaker 3", name: "研究员甲", segment-count: 41 },
        { speaker-id: 4, raw-label: "Speaker 4", name: "研究员乙", segment-count: 33 },
        { speaker-id: 5, raw-label: "Speaker 5", name: "产品负责人", segment-count: 27 },
        { speaker-id: 6, raw-label: "Speaker 6", name: "工程师", segment-count: 19 },
        { speaker-id: 7, raw-label: "Speaker 7", name: "观察员", segment-count: 14 },
        { speaker-id: 8, raw-label: "Speaker 8", name: "现场提问者", segment-count: 8 },
        { speaker-id: 9, raw-label: "Speaker 9", name: "记录员", segment-count: 0 }
    ];
    property <[StageView]> display-stages: root.fixture-enabled ? root.fixture-stages : root.stages;
    property <[SpeakerEntry]> display-speakers: root.fixture-enabled ? root.fixture-speakers : root.speakers;

    // Default to collapsed at compact widths. Direct user interaction breaks
    // this initial binding and keeps the chosen state for the App session.
    in-out property <bool> inspector-collapsed: root.width < Theme.inspector-auto-collapse-threshold;
    in property <int> inspector-toggle-focus-generation: 0;
    in property <int> inspector-tab-focus-generation: 0;
    property <int> inspector-page: 0; // 0 speakers, 1 read-only task information

    callback cancel-clicked();
    callback retry-clicked();
    callback open-md-clicked();
    callback reveal-clicked();
    callback delete-clicked();
    callback toggle-screenshots(bool);
    callback speaker-name-edited(int, string);
    callback inspector-focus-requested(bool);

    accessible-role: main;
    min-width: 640px;
    background: Theme.surface;

    if !root.display-has-job : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.surface;
        Text {
            text: "选择左侧任务查看状态与说话人配置";
            color: Theme.text-muted;
            font-size: Theme.font-body;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }

    if root.display-has-job : HorizontalLayout {
        spacing: 0px;

        // Center pane: task status only.
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.surface;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    // Content-driven height (running / failed / completed / queued
                    // / no-actions must all fit without clipping); min-height only
                    // guards the empty state (badge + title + meta + bar, no
                    // actions, no feedback line) from collapsing.
                    min-height: 102px;
                    background: Theme.surface;
                    vertical-stretch: 0;

                    VerticalLayout {
                        padding-left: Theme.space-ml;
                        padding-right: Theme.space-ml;
                        padding-top: Theme.space-md;
                        padding-bottom: Theme.space-sm;
                        spacing: Theme.space-xs;

                        // Wrapped in its own row with a trailing stretch spacer
                        // (issue 14 defect 1) so the badge's content-driven width
                        // never gets read as this VerticalLayout's max-width: the
                        // spacer's unbounded max-width keeps the row - and every
                        // ancestor up to the center pane - free to grow.
                        HorizontalLayout {
                            StatusBadge {
                                kind: StageStyle.kind(root.display-status-name, root.display-stage-name, root.display-error-visible, root.display-progress);
                                text: StageStyle.label(root.display-status-name, root.display-stage-name, root.display-error-visible, root.display-progress, root.display-status);
                                horizontal-stretch: 0;
                                // Status text moved from the meta caption below (was a
                                // duplicate of this badge); keep the live announcement
                                // here so screen readers still learn about stage changes.
                                accessible-live-region: polite;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        Text {
                            text: root.display-title;
                            color: Theme.text-primary;
                            font-size: Theme.font-title;
                            font-weight: 700;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }

                        HorizontalLayout {
                            spacing: Theme.space-xs;
                            // BV number and the separator dot are grouped on the
                            // left (both horizontal-stretch: 0, sized to content);
                            // a single spacer soaks up all the leftover width so
                            // "耗时" lands flush right without the dot drifting
                            // into the middle of the row (issue 14 defect 6).
                            Text {
                                text: root.display-bvid + (root.display-page > 1 ? "-P" + root.display-page : "");
                                color: Theme.text-secondary;
                                font-size: Theme.font-caption;
                                horizontal-stretch: 0;
                            }
                            // No separator dot here: the status text that used
                            // to follow it now lives in the StatusBadge above,
                            // so a dot would dangle after the BV id with
                            // nothing to separate it from.
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: "耗时 " + root.display-elapsed;
                                color: Theme.text-muted;
                                font-size: Theme.font-caption;
                                horizontal-stretch: 0;
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.space-xs;
                            ProgressBar {
                                value: root.display-progress;
                                height: 6px;
                                horizontal-stretch: 1;
                                bar-color: StageStyle.bar(StageStyle.kind(root.display-status-name, root.display-stage-name, root.display-error-visible, root.display-progress));
                                label: "任务总进度";
                            }
                            Text {
                                text: (root.display-completed ? 100 : root.display-progress) + "%";
                                // Follows the bar's stage kind: a pink number
                                // next to a green "completed" bar reads as two
                                // different states. `badge-text-color` is the
                                // on-light-surface variant of each kind.
                                color: StageStyle.badge-text-color(StageStyle.kind(root.display-status-name, root.display-stage-name, root.display-error-visible, root.display-progress));
                                font-size: Theme.font-caption;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }

                        if root.display-has-actions : HorizontalLayout {
                            height: Theme.control-height;
                            spacing: Theme.space-xs;
                            alignment: end;
                            if root.display-can-retry : PrimaryButton {
                                text: "重试";
                                disabled: root.action-pending;
                                clicked => { root.retry-clicked(); }
                            }
                            if !root.display-can-retry && root.display-can-open : PrimaryButton {
                                text: "打开 Markdown";
                                disabled: root.action-pending;
                                clicked => { root.open-md-clicked(); }
                            }
                            if root.display-can-retry && root.display-can-open : SecondaryButton {
                                text: "打开 Markdown";
                                disabled: root.action-pending;
                                clicked => { root.open-md-clicked(); }
                            }
                            if root.display-can-reveal : SecondaryButton {
                                text: "访达中显示";
                                disabled: root.action-pending;
                                clicked => { root.reveal-clicked(); }
                            }
                            if root.display-can-cancel : DangerOutlineButton {
                                text: "取消任务";
                                disabled: root.action-pending;
                                clicked => { root.cancel-clicked(); }
                            }
                            if root.display-can-delete : DangerOutlineButton {
                                text: "删除任务";
                                disabled: root.action-pending;
                                clicked => { root.delete-clicked(); }
                            }
                        }

                        if root.display-has-actions : Text {
                            text: root.action-feedback.is-empty ? " " : root.action-feedback;
                            color: root.action-feedback-error ? Theme.danger-text
                                : root.action-pending ? Theme.text-muted : Theme.success;
                            font-size: Theme.font-caption;
                            height: 18px;
                            overflow: elide;
                            accessible-live-region: polite;
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.separator; }

                ScrollView {
                    vertical-stretch: 1;
                    horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                    vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                    viewport-height: status-content.preferred-height;

                    status-content := VerticalLayout {
                        width: parent.width;
                        padding-left: Theme.space-ml;
                        padding-right: Theme.space-ml;
                        padding-top: Theme.space-md;
                        padding-bottom: Theme.space-lg;
                        spacing: Theme.space-ml;

                        // `visible: false` does not release layout space in Slint
                        // (issue 14 defect 8) — a hidden `Rectangle` still reserves
                        // its full height plus the VerticalLayout's `spacing` on
                        // both sides, opening a large dead gap above "阶段历史"
                        // whenever there is no error to show. Conditional
                        // instantiation (`if ... :`) removes the element from the
                        // layout entirely instead of merely hiding it.
                        if root.display-error-visible && !root.display-error.is-empty : Rectangle {
                            height: max(88px, error-message.preferred-height + 62px);
                            background: Theme.danger-surface;
                            border-radius: Theme.radius-md;
                            border-color: Theme.danger-border;
                            border-width: 1px;

                            Text {
                                text: "任务失败";
                                color: Theme.danger-text;
                                font-size: Theme.font-section;
                                font-weight: 600;
                                x: Theme.space-md;
                                y: Theme.space-sm;
                            }
                            error-message := Text {
                                text: root.display-error;
                                color: Theme.text-secondary;
                                font-size: Theme.font-body;
                                wrap: word-wrap;
                                x: Theme.space-md;
                                y: 38px;
                                width: parent.width - Theme.space-xl;
                                height: self.preferred-height;
                            }
                        }

                        // See the error card above: `if` (not `visible:`) so a
                        // hidden warning card doesn't still reserve its height
                        // (issue 14 defect 8).
                        if root.display-warning-visible : Rectangle {
                            // Content-driven height: a real HorizontalLayout (icon +
                            // wrapping text) sizes itself instead of the previous
                            // `max(64px, preferred-height + 48px)` hand calculation,
                            // so multi-line warnings never clip.
                            background: Theme.warning-surface;
                            border-radius: Theme.radius-md;
                            border-color: Theme.warning-border;
                            border-width: 1px;
                            // The visible heading was dropped from this card
                            // (see issue 08); restore the "this is a warning"
                            // semantic for screen readers via the a11y tree
                            // instead, without bringing the heading back
                            // visually (it's absent from the export image).
                            accessible-role: text;
                            accessible-label: "需要注意：" + root.display-warning;

                            HorizontalLayout {
                                padding: Theme.space-sm;
                                spacing: Theme.space-xs;

                                Image {
                                    source: @image-url("../icons/warning.svg");
                                    colorize: Theme.warning;
                                    width: 16px;
                                    height: 16px;
                                }
                                Text {
                                    text: root.display-warning;
                                    color: Theme.warning-text;
                                    font-size: Theme.font-body;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                    height: self.preferred-height;
                                    // The card above already announces this text
                                    // prefixed with the warning semantic; keep it
                                    // out of the a11y tree so it is not read twice.
                                    accessible-role: none;
                                }
                            }
                        }

                        VerticalLayout {
                            spacing: Theme.space-xs;
                            HorizontalLayout {
                                height: 22px;
                                spacing: Theme.space-xs;
                                Text {
                                    text: "阶段历史";
                                    color: Theme.text-primary;
                                    font-size: Theme.font-section;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.display-stages.length + " 个阶段";
                                    color: Theme.text-muted;
                                    font-size: Theme.font-caption;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                }
                            }

                            if root.display-stages.length == 0 : Text {
                                text: "暂无阶段信息";
                                color: Theme.text-muted;
                                font-size: Theme.font-body;
                                height: 40px;
                                vertical-alignment: center;
                            }

                            for st in root.display-stages : StageRow { stage: st; }
                        }
                    }
                }
            }
        }

        Rectangle {
            width: 1px;
            horizontal-stretch: 0;
            background: Theme.separator;
        }

        // Collapsed rail: preserves a visible, keyboard-reachable affordance.
        if root.inspector-collapsed : Rectangle {
            width: Theme.inspector-collapsed-width;
            horizontal-stretch: 0;
            background: Theme.sidebar-background;

            VerticalLayout {
                padding-top: Theme.space-xs;
                alignment: start;
                expand-toggle := IconButton {
                    icon: @image-url("../icons/chevron-left.svg");
                    label: root.inspector-page == 0 ? "展开说话人配置" : "展开任务信息";
                    size: Theme.control-height-compact;
                    bordered: false;
                    focus-generation: root.inspector-toggle-focus-generation;
                    x: (parent.width - self.width) / 2;
                    clicked => {
                        root.inspector-collapsed = false;
                        root.inspector-focus-requested(false);
                    }
                }
                Text {
                    text: root.inspector-page == 0 ? "说\n话\n人\n配\n置" : "任\n务\n信\n息";
                    color: Theme.text-muted;
                    font-size: Theme.font-caption;
                    font-weight: 600;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    width: parent.width;
                    height: 112px;
                }
            }
        }

        // Expanded inspector: speaker configuration and read-only task information are
        // separate pages, so neither is pushed below task status content.
        if !root.inspector-collapsed : Rectangle {
            width: Theme.inspector-width;
            horizontal-stretch: 0;
            background: Theme.sidebar-background;

            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: 42px;
                    background: Theme.sidebar-background;
                    HorizontalLayout {
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-xs;
                        spacing: Theme.space-xs;
                        Text {
                            text: "检查器";
                            color: Theme.text-secondary;
                            font-size: Theme.font-caption;
                            font-weight: 600;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        collapse-toggle := IconButton {
                            icon: @image-url("../icons/chevron-right.svg");
                            label: "收起检查器";
                            size: Theme.control-height-compact;
                            bordered: false;
                            focus-generation: root.inspector-toggle-focus-generation;
                            clicked => {
                                root.inspector-collapsed = true;
                                root.inspector-focus-requested(true);
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.separator; }

                // Segmented tab bar. The outer bar (`Theme.surface`)
                // just provides breathing room; `segment-track` is the actual
                // `segment-track`-colored pill that carries the two tabs.
                Rectangle {
                    height: Theme.space-xs + Theme.space-xs + Theme.control-height;
                    background: Theme.surface;
                    accessible-role: tab-list;
                    accessible-label: "检查器页面";

                    HorizontalLayout {
                        padding: Theme.space-xs;

                        segment-track := Rectangle {
                            horizontal-stretch: 1;
                            height: Theme.control-height;
                            border-radius: Theme.radius-md;
                            background: Theme.segment-track;

                            HorizontalLayout {
                                padding: 2px;
                                spacing: 2px;

                                speaker-tab := InspectorTab {
                                    text: "说话人 · " + root.display-speakers.length;
                                    selected: root.inspector-page == 0;
                                    focus-generation: root.inspector-tab-focus-generation;
                                    clicked => {
                                        root.inspector-page = 0;
                                    }
                                    navigate(delta) => {
                                        if delta > 0 {
                                            root.inspector-page = 1;
                                        }
                                    }
                                }
                                info-tab := InspectorTab {
                                    text: "任务信息";
                                    selected: root.inspector-page == 1;
                                    focus-generation: root.inspector-tab-focus-generation;
                                    clicked => {
                                        root.inspector-page = 1;
                                    }
                                    navigate(delta) => {
                                        if delta < 0 {
                                            root.inspector-page = 0;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.separator; }

                if root.inspector-page == 0 : Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    accessible-role: tab-panel;
                    accessible-label: "说话人配置";

                    VerticalLayout {
                        padding-left: Theme.space-sm;
                        padding-right: Theme.space-sm;
                        padding-top: Theme.space-sm;
                        padding-bottom: Theme.space-sm;
                        spacing: Theme.space-xs;

                        Text {
                            text: root.display-can-edit-speakers
                                ? "显示名称会写入 Markdown，编辑后自动更新文档。"
                                : "转写完成后可编辑说话人显示名称。";
                            color: Theme.text-muted;
                            font-size: Theme.font-caption;
                            wrap: word-wrap;
                            height: max(34px, self.preferred-height);
                        }

                        Text {
                            text: root.speaker-feedback.is-empty ? " " : root.speaker-feedback;
                            color: root.speaker-feedback-error ? Theme.danger-text
                                : root.speaker-feedback == "已保存" ? Theme.success : Theme.text-muted;
                            font-size: Theme.font-caption;
                            height: 18px;
                            overflow: elide;
                            accessible-live-region: polite;
                        }

                        if root.display-speakers.length == 0 : Text {
                            text: "尚未识别到说话人";
                            color: Theme.text-muted;
                            font-size: Theme.font-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            vertical-stretch: 1;
                        }

                        if root.display-speakers.length > 0 : ListView {
                            vertical-stretch: 1;
                            vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                            for sp in root.display-speakers : SpeakerRow {
                                entry: sp;
                                enabled: root.display-can-edit-speakers;
                                name-edited(name) => { root.speaker-name-edited(sp.speaker-id, name); }
                            }
                        }
                    }
                }

                if root.inspector-page == 1 : Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface;
                    accessible-role: tab-panel;
                    accessible-label: "任务信息";

                    ScrollView {
                        vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        viewport-height: task-info-content.preferred-height;

                        task-info-content := VerticalLayout {
                            width: parent.width;
                            padding: Theme.space-md;
                            spacing: Theme.space-md;
                            alignment: start;

                            Text {
                                text: "只读任务快照；可编辑项仅位于说话人配置与设置。";
                                color: Theme.text-muted;
                                font-size: Theme.font-caption;
                                wrap: word-wrap;
                                height: self.preferred-height;
                            }

                            VerticalLayout {
                                spacing: Theme.space-xxs;
                                Text {
                                    text: "转写设置";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-caption;
                                    font-weight: 600;
                                }
                                OptionRow {
                                    label: "Runtime";
                                    value: root.display-transcription-runtime;
                                }
                                OptionRow {
                                    label: "来源";
                                    value: root.display-transcription-source;
                                }
                                OptionRow {
                                    label: "Backend";
                                    value: root.display-transcription-backend;
                                }
                                OptionRow {
                                    label: "模型说明";
                                    value: root.display-transcription-model;
                                }
                                OptionRow {
                                    label: "请求语言";
                                    value: root.display-requested-language;
                                }
                                OptionRow {
                                    label: "实际语言";
                                    value: root.display-reported-language;
                                }
                                OptionRow {
                                    label: "实际模型";
                                    value: root.display-reported-model;
                                }
                            }

                            Rectangle { height: 1px; background: Theme.separator; }

                            VerticalLayout {
                                spacing: Theme.space-xxs;
                                Text {
                                    text: "时间";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-caption;
                                    font-weight: 600;
                                }
                                OptionRow {
                                    label: "创建时间";
                                    value: root.display-created-at;
                                }
                                OptionRow {
                                    label: "开始时间";
                                    value: root.display-started-at;
                                }
                                OptionRow {
                                    label: "结束时间";
                                    value: root.display-finished-at;
                                }
                                OptionRow {
                                    label: "处理用时";
                                    value: root.display-elapsed;
                                }
                            }

                            Rectangle { height: 1px; background: Theme.separator; }

                            VerticalLayout {
                                spacing: Theme.space-xxs;
                                Text {
                                    text: "媒体与产出";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-caption;
                                    font-weight: 600;
                                }
                                OptionRow {
                                    label: "视频时长";
                                    value: root.display-video-duration;
                                }
                                OptionRow {
                                    label: "媒体占用";
                                    value: root.display-media-size;
                                }
                                OptionRow {
                                    label: "Markdown";
                                    value: root.display-document-words;
                                }
                                OptionRow {
                                    label: "保留策略";
                                    value: root.display-retention;
                                }
                                OptionRow {
                                    label: "截图产物";
                                    value: root.screenshots-enabled ? "已启用" : "未启用";
                                    muted: !root.screenshots-enabled;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

}
