import { Theme } from "../theme.slint";

// AppTextField: hand-rolled text input built on the builtin `TextInput`,
// following Slint's own `LineEditBase` structure
// (~/.cargo/registry/.../i-slint-compiler-1.17.1/widgets/common/lineedit-base.slint):
// TextInput + placeholder Text + ContextMenuArea (cut/copy/paste/select-all).
// It exists because `Palette` in the builtin styles is read-only outside
// `color-scheme`, so the builtin `LineEdit`'s focus ring and radius cannot be
// recolored to the brand accent required by the current UI design spec.
//
// Public surface mirrors `LineEditInterface`
// (widgets/interfaces/lineedit.slint:4-30): properties `text`,
// `placeholder-text`, `enabled`, `read-only`, `font-size`,
// `horizontal-alignment`, `has-focus`; callbacks `accepted(text: string)` /
// `edited(text: string)`; functions `select-all()` / `clear-selection()` /
// `cut()` / `copy()` / `paste()`.
//
// BiMyScribe-specific additions:
//   - `leading-icon`: optional 14px icon drawn before the text, colorized
//     with `text-muted`. Left unset, no icon column is reserved.
//   - `compact`: false (default) = `control-height-lg`(36) + `radius-md`(8);
//     true = `control-height`(32) + `radius-sm`(6).
// `accessible-label` needs no custom property: it is already a builtin
// property on every Slint element, so call sites set it directly
// (`AppTextField { accessible-label: "..."; }`).
//
// Not implemented (no call site in this project needs them; see issue 04):
//   - `input-type` (password / number / etc.) — always plain text.
//   - `key-pressed` / `key-released` callbacks.
export component AppTextField inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder-text: "";
    in property <bool> enabled: true;
    in property <bool> read-only: false;
    in property <length> font-size: Theme.font-body;
    in property <TextHorizontalAlignment> horizontal-alignment: left;
    out property <bool> has-focus: text-input.has-focus;

    in property <image> leading-icon;
    in property <bool> compact: false;
    // `accessible-label` is a builtin property already available on every
    // element (like `accessible-role`); call sites set it directly, e.g.
    // `AppTextField { accessible-label: "..."; }`. No custom property needed.

    // Internal: extra breathing room (beyond the text cursor width) before
    // horizontal auto-scroll kicks in. Mirrors `LineEditBase.margin`
    // (lineedit-base.slint:30, fed from the surrounding layout's padding in
    // widgets/cupertino/lineedit.slint:61); not part of the public surface.
    property <length> scroll-margin: Theme.space-xxs;

    callback accepted(string);
    callback edited(string);

    public function set-selection-offsets(start: int, end: int) {
        text-input.set-selection-offsets(start, end);
    }
    public function select-all() {
        text-input.select-all();
    }
    public function clear-selection() {
        text-input.clear-selection();
    }
    public function cut() {
        text-input.cut();
    }
    public function copy() {
        text-input.copy();
    }
    public function paste() {
        text-input.paste();
    }

    height: root.compact ? Theme.control-height : Theme.control-height-lg;
    min-width: 1px;
    clip: true;
    forward-focus: text-input;

    accessible-role: AccessibleRole.text-input;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-enabled: root.enabled;
    accessible-read-only: root.read-only;
    accessible-action-set-value(v) => {
        // Assistive technology must not bypass the disabled / read-only
        // state the way a plain write would; std `LineEdit` refuses the
        // action in both cases and so do we.
        if (root.enabled && !root.read-only) {
            root.text = v;
            root.edited(v);
        }
    }

    background: root.enabled ? Theme.surface : Theme.surface-disabled;
    border-radius: root.compact ? Theme.radius-sm : Theme.radius-md;
    border-width: text-input.has-focus ? 2px : 1px;
    border-color: !root.enabled ? Theme.border
        : text-input.has-focus ? Theme.accent
        : Theme.border;

    HorizontalLayout {
        padding-left: Theme.space-sm;
        padding-right: Theme.space-sm;
        spacing: Theme.space-xxs;

        // `Image.vertical-alignment` only positions the image's *content*
        // within its own box; it does not position that box within the
        // surrounding `HorizontalLayout`'s cross axis, so a fixed-height
        // Image ends up pinned to the layout's top edge (issue 14 defect 2).
        // Wrapping it in a `VerticalLayout { alignment: center; }` centers
        // the box itself in the row.
        if root.leading-icon.width > 0: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;

            Image {
                source: root.leading-icon;
                colorize: Theme.text-muted;
                width: 14px;
                height: 14px;
            }
        }

        input-area := Rectangle {
            horizontal-stretch: 1;
            clip: true;

            placeholder := Text {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                horizontal-alignment: root.horizontal-alignment;
                // Hidden while an IME composition is in progress, even
                // though `root.text` is still empty at that point.
                text: (root.text == "" && text-input.preedit-text == "") ? root.placeholder-text : "";
                font-size: text-input.font-size;
                // Disabled keeps `text-muted`: `text-disabled` on `surface-disabled`
                // is only 1.65:1 (issue 14 defect 4 applied the same fix to buttons).
                color: Theme.text-muted;
                // `accessible-placeholder-text` is already set on root.
                accessible-role: none;
            }

            ContextMenuArea {
                enabled: root.enabled;

                Menu {
                    MenuItem {
                        title: "剪切";
                        enabled: !root.read-only && root.enabled;
                        activated => { text-input.cut(); }
                    }
                    MenuItem {
                        title: "复制";
                        enabled: !root.text.is-empty;
                        activated => { text-input.copy(); }
                    }
                    MenuItem {
                        title: "粘贴";
                        enabled: !root.read-only && root.enabled;
                        activated => { text-input.paste(); }
                    }
                    MenuItem {
                        title: "全选";
                        enabled: !root.text.is-empty;
                        activated => { text-input.select-all(); }
                    }
                }

                text-input := TextInput {
                    property <length> computed-x;

                    text <=> root.text;
                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: 100%;
                    vertical-alignment: center;
                    horizontal-alignment: root.horizontal-alignment;
                    single-line: true;
                    font-size: root.font-size;
                    enabled: root.enabled;
                    read-only: root.read-only;
                    color: root.enabled ? Theme.text-primary : Theme.text-muted;
                    // The outer Rectangle already exposes the accessible
                    // surface; disable TextInput's own to avoid duplicates.
                    accessible-role: none;

                    cursor-position-changed(cursor-position) => {
                        if cursor-position.x + self.computed-x < root.scroll-margin {
                            self.computed-x = - cursor-position.x + root.scroll-margin;
                        } else if cursor-position.x + self.computed-x > parent.width - root.scroll-margin - self.text-cursor-width {
                            self.computed-x = parent.width - cursor-position.x - root.scroll-margin - self.text-cursor-width;
                        }
                    }

                    accepted => {
                        root.accepted(self.text);
                    }

                    edited => {
                        root.edited(self.text);
                    }
                }
            }
        }
    }
}
