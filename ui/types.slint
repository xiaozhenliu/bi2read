// Shared data types passed between Rust and Slint.
// These mirror the structs on the Rust side (see src/jobs.rs, src/config.rs).

export struct StageView {
    name: string,
    label: string,
    done: bool,
    active: bool,
    progress: int,        // 0..100 for the active stage
    indeterminate: bool,
    error: bool,
    skipped: bool,
}

export struct SpeakerEntry {
    speaker-id: int,
    raw-label: string,
    name: string,
    // Number of transcript segments (utterances) attributed to this speaker,
    // sourced from `transcript.raw.json` in `src/main.rs::set_detail_for`.
    // 0 means the count is unavailable (e.g. no raw transcript yet), not
    // "zero segments observed" — call sites must hide the count at 0.
    segment-count: int,
}
