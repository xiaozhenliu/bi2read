// Design tokens shared across the app. Accessed as `Theme.color-xxx` from any
// component, and `app.global::<Theme>()` from Rust.
export global Theme {
    // Window
    out property <color> window-background: #F8F9FA;
    out property <color> sidebar-background: #F5F6F7;
    out property <color> content-background: #ffffff;
    out property <length> window-width: 1180px;
    out property <length> window-height: 760px;
    out property <length> window-min-width: 920px;
    out property <length> window-min-height: 600px;
    out property <length> sidebar-width: 268px;
    out property <length> sidebar-min-width: 252px;
    out property <length> sidebar-max-width: 292px;
    out property <length> inspector-width: 300px;
    out property <length> inspector-collapsed-width: 44px;
    // App width 1080px minus the 268px queue and 1px divider.
    out property <length> inspector-auto-collapse-threshold: 811px;

    // Surfaces
    out property <color> surface: #ffffff;
    out property <color> surface-muted: #F6F7F8;
    out property <color> surface-hover: #F1F2F3;
    out property <color> surface-selected: #F0F7FA;
    out property <color> surface-pressed: #E3E5E7;
    out property <color> surface-disabled: #F1F2F3;
    out property <color> surface-footer: #FAFAFA;
    out property <color> border: #E3E5E7;
    out property <color> border-strong: #C9CDD1;
    out property <color> separator: #EEF0F2;
    out property <color> overlay: #2B242966;
    // Shadows. `shadow-subtle` lifts small controls (switch thumb, selected
    // segment); `shadow-modal` is the settings dialog elevation.
    out property <color> shadow-subtle: #00000030;
    // The selected segment uses an 8% black lift for visible depth.
    out property <color> shadow-segment: #00000014;
    out property <color> shadow-modal: #0000002e;

    // Text
    out property <color> text-primary: #18191C;
    out property <color> text-secondary: #61666D;
    // Neutral metadata remains readable on white and pale-blue surfaces.
    out property <color> text-muted: #6B7076;
    out property <color> text-disabled: #AEB3BA;
    out property <color> on-accent: #ffffff;

    // Accents / states
    out property <color> accent: #FB7299;
    out property <color> brand-hover: #FA5C8A;
    out property <color> brand-pressed: #F0447A;
    out property <color> on-brand: #FFFFFF;
    // Completed facts recede; only current actions use saturated blue.
    out property <color> success: #7A8189;
    out property <color> success-surface: #F1F2F3;
    out property <color> success-text: #61666D;
    out property <color> warning: #B7791F;
    out property <color> warning-surface: #FBF2DF;
    out property <color> warning-border: #EBDCB4;
    out property <color> warning-text: #8A5A12;
    out property <color> danger: #C34F59;
    out property <color> danger-surface: #F6F7F8;
    out property <color> danger-border: #C9CDD1;
    out property <color> danger-text: #AB3641;
    // Selection/focus share a deep-blue edge against pale-blue surfaces.
    out property <color> selection: #006A91;
    out property <color> focus-ring: #006A91;
    // Bilibili web blue fills; darker cyan text preserves small-label contrast.
    out property <color> progress: #00AEEC;
    out property <color> progress-text: #006A91;
    out property <color> action: #00AEEC;
    out property <color> action-hover: #40C5F1;
    out property <color> action-pressed: #008AC5;
    out property <color> on-action: #FFFFFF;
    out property <color> danger-hover: #B74450;
    out property <color> danger-pressed: #A33A46;
    out property <color> track: #E3E5E7;
    out property <color> selected-track: #DCECF3;
    out property <color> segment-track: #F1F2F3;

    // Download stage (bilibili blue)
    out property <color> info: #006A91;
    out property <color> info-surface: #F0F7FA;
    // Stage labels distinguish activities; their color shares the active role.
    out property <color> info-text: #006A91;

    // AI polish stage (active blue)
    out property <color> polish: #006A91;
    out property <color> polish-surface: #F0F7FA;
    out property <color> polish-text: #006A91;

    // Spacing scale
    out property <length> space-xxs: 4px;
    out property <length> space-xs: 8px;
    out property <length> space-sm: 12px;
    out property <length> space-md: 16px;
    out property <length> space-ml: 20px;
    out property <length> space-lg: 24px;
    out property <length> space-xl: 32px;

    // Radius
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    out property <length> pill-radius: 12px;

    // Control metrics
    out property <length> control-height: 32px;
    out property <length> control-height-lg: 36px;
    out property <length> control-height-compact: 28px;
    out property <length> task-row-height: 88px;
    out property <length> task-row-gap: 8px;
    out property <length> pill-height: 24px;
    out property <length> icon-button-size: 36px;

    // Semantic type scale. Interface text below 12px is intentionally banned.
    out property <length> font-caption: 12px;
    out property <length> font-body: 14px;
    out property <length> font-section: 14px;
    out property <length> font-title: 18px;

    // Compatibility aliases for components that have not yet moved to the
    // semantic names. Keep the values on the same four-step scale.
    out property <length> font-xs: 12px;
    out property <length> font-sm: 14px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 14px;
    out property <length> font-xl: 18px;
}
