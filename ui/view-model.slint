import { StageView, SpeakerEntry } from "types.slint";

// View model for one row in the queue list.
export struct JobRow {
    id: string,
    title: string,
    bvid: string,
    page: int,
    stage-name: string,
    stage-label: string,
    stage-progress: int,        // 0..100 for current stage
    total-progress: int,       // 0..100 across whole job
    indeterminate: bool,
    elapsed-secs: int,
    elapsed: string,           // preformatted "MM:SS"
    selected: bool,
    has-error: bool,
    error-text: string,
    status-label: string,
    // Machine-readable JobStatus key (src/jobs.rs JobStatus::name()).
    // Outranks `stage-name` in StageStyle when task-level status is
    // decisive (e.g. `cancelling`).
    status-name: string,
}

// Aggregated view for the detail panel of the selected job.
//
// The Rust controller is the only producer of this snapshot.  Fields are
// deliberately preformatted here so Slint never has to guess whether a
// missing value is a real zero.  A refresh replaces the complete struct when
// selection changes; background snapshots update the same fields atomically.
export struct JobDetailData {
    has-job: bool,             // queue job selected; false shows the empty state
    title: string,             // Job.title, refreshed on every job snapshot
    bvid: string,              // Job.bvid
    page: int,                 // Job.page (1-based)
    status-label: string,      // JobStatus::label()
    // Machine-readable current stage key, symmetric with `JobRow.stage-name`
    // (src/jobs.rs Stage::name()). `JobDetailData` has no way to derive this
    // in Slint (no expression-language loop over `stages` to find the active
    // one), so Rust fills it directly from `snap.stage.name()`.
    stage-name: string,
    // Machine-readable JobStatus key (src/jobs.rs JobStatus::name()), symmetric
    // with `JobRow.status-name`. Outranks `stage-name` in StageStyle when
    // task-level status is decisive.
    status-name: string,
    total-progress: int,       // Job::total_progress(), 0..100
    elapsed-secs: int,         // started_at..finished_at/now, seconds
    elapsed: string,           // local display; "—" when started_at is absent
    error-text: string,        // Job.error; empty means no error
    has-error: bool,            // Job.error.is_some()
    warning-text: string,      // JobWarning::label(); empty means none
    can-cancel: bool,          // JobCapabilities::can_cancel
    can-retry: bool,           // JobCapabilities::can_retry
    can-rebuild: bool,         // explicit legacy Job recreation with current settings
    can-open: bool,             // JobCapabilities::can_open_document
    can-reveal: bool,           // JobCapabilities::can_reveal
    can-delete: bool,           // JobCapabilities::can_delete (terminal jobs only)
    can-edit-speakers: bool,    // transcript.raw.json exists
    screenshots-enabled: bool, // current screenshot capability (false until backend exists)
    retention-label: string,   // Job.retention.label()
    created-at: string,        // Job.created_at in local YYYY-MM-DD HH:mm:ss
    started-at: string,        // Job.started_at in local YYYY-MM-DD HH:mm:ss, or "—"
    finished-at: string,       // Job.finished_at in local YYYY-MM-DD HH:mm:ss, or "—"
    video-duration: string,    // Job.duration_ms only; unknown/zero is "—"
    media-size: string,        // existing source.audio/video bytes or retention placeholder
    document-words: string,    // final full.md, then raw markdown with "原始稿"
    transcription-runtime: string,
    transcription-source: string,
    transcription-backend: string,
    transcription-model: string,
    requested-language: string,
    reported-language: string,
    reported-model: string,
    // v0.6 F5: task information panel's two read-only rows share the same
    // primary-consumption estimate as the result header and full.md. Missing
    // shows "—" rather than 0; handling time stays on its own line.
    reading-estimate: string,
    reading-saved: string,
    reading-profile: string,
    can-view-result: bool,       // terminal v0.5 job with validated raw Evidence
}

// One flat row in the v0.5 result view.  Section, block, and raw Evidence
// rows deliberately share this shape so each tab can be rendered by one
// virtual ListView; source details are inline in the same row rather than a
// nested scroller or a second business model.
export struct ContentRow {
    id: string,
    kind: string,                // section / block / raw / empty
    title: string,
    text: string,
    declaration: string,
    status-label: string,
    status-kind: string,         // mapped / limited / failure / pending / neutral
    source-text: string,
    source-speaker: string,
    source-range: string,
    source-url: string,
    can-source: bool,
    can-jump: bool,
    action-kind: string,         // summary / highlights / chapters / open-raw
    action-label: string,
    action-pending: bool,
    action-caption: string,      // F2: "将使用：{model}" for every section with an action
}

// Read-only projection of ContentResults::current.  The Rust controller is
// the only producer; Slint owns only transient tab/source expansion state.
export struct ContentResultsData {
    entry-visible: bool,
    mode: string,                // current / raw-only / unavailable
    title: string,
    job-id: string,
    bvid: string,
    page: int,
    video-duration: string,
    // v0.6 F5: versioned reading estimate caption for the fixed header.
    // Empty when no reliable profile exists; otherwise
    // "视频 {D} 分钟 · 正文约 {N} 字 · 预计阅读约 {M} 分钟 · 预计节省约 {K} 分钟 · {P}%（相对 1.0x 观看）".
    reading-caption: string,
    reading-profile: string,     // "reading-profile v1" when estimate is available
    show-reading-explainer: bool,
    reading-explainer: string,
    // F2: page-level neutral banner when current model differs from newest record.
    model-notice: string,
    show-model-notice: bool,
    // F4: search state (active replaces tab content with results in the same ListView).
    search-active: bool,
    search-query: string,
    search-result-count: int,
    search-rows: [ContentRow],
    status-label: string,
    notice: string,
    notice-error: bool,
    source-url: string,
    default-tab: int,            // 0 summary, 1 chapters, 2 faithful, 3 raw
    summary-tier: int,           // 0 short, 1 standard, 2 long (F3)
    show-summary: bool,
    show-chapters: bool,
    show-faithful: bool,
    show-raw: bool,
    can-repair: bool,
    repair-pending: bool,
    repair-label: string,
    summary-rows: [ContentRow],
    chapters-rows: [ContentRow],
    faithful-rows: [ContentRow],
    raw-rows: [ContentRow],
}

// Settings view model bound to the settings modal.
export struct SettingsView {
    working-dir: string,
    output-dir: string,
    runtime-project: string,
    runtime-bundled: bool,
    funasr-status: string,
    runtime-data-dir: string,
    llm-enabled: bool,
    llm-connection-name: string,
    llm-model: string,
    llm-base-url: string,
    llm-api-format: string,
    llm-remote-warn: bool,
    default-screenshots: bool,
    default-retention: string,
}
